{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-write.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/estado.mjs --session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-design-system.mjs --changed --quiet",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node scripts/estado.mjs --stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
